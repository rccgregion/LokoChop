rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Test connection endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // Orders collection: Customers create orders and confirm payment; vendors verify credit & set ETA
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.totalAmount > 0;
      allow update: if true;
      allow delete: if false;
    }

    // Vendors public directory and status
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
